# Any OpenAI-compatible server (llama-swap, LocalAI, Ollama, vLLM, OpenAI...)
OPENAI_BASE_URL=http://192.168.1.158:8080/v1
# Default model; the UI dropdown can override it per request
OPENAI_MODEL=spark-instruct
# Local servers usually ignore the key, but the client needs a value
OPENAI_API_KEY=not-needed
TRANSCRIBE_MODEL=whisper-1
# Embedding model for semantic search across documents
EMBEDDING_MODEL=embedding
# Where documents and the search index are stored (default: backend/app/data)
# DATA_DIR=/path/to/data
# Browser origins allowed to call the backend (comma-separated). Add the
# address you open the editor from, e.g. http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
